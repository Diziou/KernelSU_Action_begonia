KERNEL_SOURCE=https://github.com/<你的用户名>/begonia_kernel_dev
KERNEL_SOURCE_BRANCH=Suzaku-bka
KERNEL_CONFIG=begonia_user_defconfig
ARCH=arm64
KERNEL_FILE=Image.gz-dtb
EXTRA_BUILD_COMMAND:LD=ld.lld
DISABLE-LTO=false
ENABLE_KERNELSU=false        # 关键：保留你的 Magisk，不换 KernelSU
APPLY_KSU_PATCH=false
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false
DISABLE_CC_WERROR=true
